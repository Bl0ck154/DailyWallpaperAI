<Window x:Class="DailyWallpaperAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daily Wallpaper AI" Width="1240" Height="830" MinWidth="990" MinHeight="670"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="Eyebrow" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="CharacterSpacing" Value="1"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="34"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,8,0,8"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Subtitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#C4CED9"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Padding" Value="25"/>
    </Style>
    <Style x:Key="NavItem" TargetType="TabItem">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="NavBorder" Background="Transparent" CornerRadius="11"
                    BorderBrush="Transparent" BorderThickness="1" Padding="17,14">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="NavBorder" Property="Background" Value="#273329"/>
                <Setter TargetName="NavBorder" Property="BorderBrush" Value="#41563C"/>
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavBorder" Property="Background" Value="#262E37"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ShellTabs" TargetType="TabControl">
      <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}"/>
      <Setter Property="Background" Value="{StaticResource Bg}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="226"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="{StaticResource Side}" BorderBrush="#232B35"
                      BorderThickness="0,0,1,0" Padding="19,27,19,18">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Margin="10,4,0,48">
                    <StackPanel Orientation="Horizontal">
                      <Border Width="36" Height="36" Background="{StaticResource Accent}" CornerRadius="11" Margin="0,0,10,0">
                        <TextBlock Text="✦" Foreground="{StaticResource AccentFg}" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DAILY" FontWeight="Bold" FontSize="18"/>
                        <TextBlock Text="WALLPAPER STUDIO" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="SemiBold"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel DockPanel.Dock="Bottom" Margin="8,12,8,0">
                    <Border Height="1" Background="{StaticResource Stroke}" Margin="0,0,0,18"/>
                    <TextBlock Text="LOCAL-FIRST STUDIO" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="Your images stay on this PC unless you choose to generate with Codex."
                               Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/>
                    <TextBlock Text="ALPHA • v0.1" Foreground="#687584" FontSize="10" Margin="0,22,0,0"/>
                  </StackPanel>
                  <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                </DockPanel>
              </Border>
              <Border Grid.Column="1" Background="{StaticResource Bg}">
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="29,27,29,16"/>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Pill" TargetType="Border">
      <Setter Property="Background" Value="#202A28"/>
      <Setter Property="BorderBrush" Value="#384A3A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Padding" Value="12,6"/>
    </Style>
    <Style x:Key="GalleryTile" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,13,13"/>
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="TileBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="13"
                    Padding="7">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="TileBorder" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TileBorder" Property="Background" Value="{StaticResource Panel2}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="46"/>
    </Grid.RowDefinitions>
    <TabControl x:Name="Tabs" Grid.Row="0" Style="{StaticResource ShellTabs}" SelectionChanged="Tabs_SelectionChanged">

      <TabItem Header="⌂   Overview">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <DockPanel Margin="0,0,0,25" LastChildFill="True">
              <Border Style="{StaticResource Pill}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="●  LOCAL STUDIO" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/>
              </Border>
              <StackPanel>
                <TextBlock Text="YOUR DESKTOP, REIMAGINED" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="A new view, every day." Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Create a beautiful desktop with one idea and a little imagination."
                           Style="{StaticResource Subtitle}" Margin="0,0,0,0"/>
              </StackPanel>
            </DockPanel>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" CornerRadius="21" BorderBrush="{StaticResource Stroke}"
                      BorderThickness="1" Background="#182534" Height="439" ClipToBounds="True">
                <Grid>
                  <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#152C36" Offset="0"/>
                      <GradientStop Color="#172536" Offset="0.50"/>
                      <GradientStop Color="#31304A" Offset="1"/>
                    </LinearGradientBrush>
                  </Grid.Background>
                  <Ellipse Width="350" Height="350" Fill="#8096B3" Opacity=".08"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-170,-90,0"/>
                  <Canvas VerticalAlignment="Bottom" Height="220" Opacity=".4" IsHitTestVisible="False">
                    <Polygon Points="0,195 95,120 200,180 315,60 460,166 640,95 780,190 780,220 0,220"
                             Fill="#314C58"/>
                    <Polygon Points="0,218 130,151 250,215 410,100 510,189 680,125 810,210 810,220 0,220"
                             Fill="#142F41"/>
                  </Canvas>
                  <Image x:Name="PreviewImage" Stretch="UniformToFill"/>
                  <StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="30" MaxWidth="300" IsHitTestVisible="False">
                    <TextBlock Text="✦" FontSize="44" Foreground="{StaticResource Accent}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Your canvas is waiting." FontSize="21" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,14,0,8"/>
                    <TextBlock Text="Generate your first wallpaper to see it here."
                               Foreground="#C2CCD8" TextAlignment="Center" FontSize="13"/>
                  </StackPanel>
                  <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" VerticalAlignment="Top"
                          Margin="19" Background="#D817212A">
                    <TextBlock Text="◉  DESKTOP PREVIEW" Foreground="#E8F0FA" FontSize="10" FontWeight="SemiBold"/>
                  </Border>
                  <Border Background="#C70D1117" VerticalAlignment="Bottom" Padding="18,13">
                    <DockPanel>
                      <TextBlock Text="LATEST WALLPAPER" Foreground="#9EABBA" FontSize="10"
                                 FontWeight="SemiBold" DockPanel.Dock="Left" Margin="0,0,12,0"/>
                      <TextBlock x:Name="LastWallpaperLabel" Foreground="White" FontSize="11"
                                 TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                  </Border>
                </Grid>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource Card}" Height="439">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <StackPanel Grid.Row="0">
                    <TextBlock Text="CREATE" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="Make something new" Style="{StaticResource SectionTitle}" Margin="0,9,0,5"/>
                    <TextBlock x:Name="ActiveScenarioLabel" Foreground="{StaticResource Muted}"
                               FontSize="12" Margin="0,0,0,24"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1">
                    <TextBlock Text="YOUR IDEA" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="OneOffPromptBox" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="122" VerticalScrollBarVisibility="Auto"
                             ToolTip="Optional. Leave empty to use the active scenario."
                             Margin="0,9,0,5"/>
                    <TextBlock Text="Leave empty to use your active scenario." Foreground="{StaticResource Muted}"
                               FontSize="11" Margin="0,2,0,8"/>
                  </StackPanel>
                  <StackPanel Grid.Row="3">
                    <Button x:Name="GenerateButton" Content="✦  Generate wallpaper" Style="{StaticResource PrimaryButton}"
                            Click="Generate_Click" HorizontalContentAlignment="Center" Height="49" Margin="0,0,0,9"/>
                    <Button x:Name="CancelButton" Content="Cancel generation" Click="Cancel_Click"
                            IsEnabled="False" HorizontalContentAlignment="Center" Margin="0,0,0,9"/>
                    <Button Content="↗  Open wallpaper folder" Click="OpenFolder_Click"
                            Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" Margin="0"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>

            <Grid Margin="0,20,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Card}" Padding="21">
                <StackPanel>
                  <TextBlock Text="01  /  SCENARIO ENGINE" Style="{StaticResource Eyebrow}"/>
                  <TextBlock Text="Fresh ideas. No repeats." FontWeight="SemiBold" FontSize="17" Margin="0,12,0,4"/>
                  <TextBlock Text="Rotate locations and moods automatically until every variation has been used."
                             Foreground="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="21">
                <StackPanel>
                  <TextBlock Text="02  /  MADE FOR YOU" Style="{StaticResource Eyebrow}"/>
                  <TextBlock Text="Your photos, your atmosphere." FontWeight="SemiBold" FontSize="17" Margin="0,12,0,4"/>
                  <TextBlock Text="Add optional reference images and keep every generated result in your local gallery."
                             Foreground="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="◇   Scenarios">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="YOUR CREATIVE PLAYBOOK" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Scenes &amp; stories." Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Create a recurring visual world. Locations and moods will vary automatically."
                       Style="{StaticResource Subtitle}" Margin="0,0,0,26"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="ACTIVE COLLECTION" Style="{StaticResource Eyebrow}"/>
                <Grid Margin="0,12,0,17">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="ScenarioPicker" Grid.Column="0" DisplayMemberPath="Name"
                            SelectionChanged="ScenarioPicker_SelectionChanged" Margin="0,0,12,0"/>
                  <Button Grid.Column="1" Content="+ New" Click="AddScenario_Click" Margin="0,0,9,0"/>
                  <Button Grid.Column="2" Content="Delete" Click="DeleteScenario_Click"
                          Style="{StaticResource DangerButton}" Margin="0"/>
                </Grid>
                <TextBlock Text="SCENARIO NAME" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ScenarioName"/>
                <TextBlock Text="PROMPT TEMPLATE" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ScenarioPrompt" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="112" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="Use {{place}} and {{mood}} to automatically remix each wallpaper."
                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,-8,0,22"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="PLACES · ONE PER LINE" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PlacesBox" AcceptsReturn="True" Height="110"
                             VerticalScrollBarVisibility="Auto"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="MOODS · ONE PER LINE" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="MoodsBox" AcceptsReturn="True" Height="110"
                             VerticalScrollBarVisibility="Auto"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="VISUAL STYLE" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ScenarioStyle"/>
                <TextBlock Text="AVOID IN IMAGES" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ScenarioAvoid"/>
                <Button Content="Save scenario  →" Style="{StaticResource PrimaryButton}" Click="SaveScenario_Click"
                        HorizontalAlignment="Left" Margin="0,7,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="▦   Gallery">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="YOUR PERSONAL COLLECTION" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="The gallery." Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="GalleryCountText" Text="All your saved wallpapers, ready to revisit."
                       Foreground="{StaticResource Muted}" FontSize="13"/>
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.1*"/>
              <ColumnDefinition Width="18"/>
              <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
              <ListBox x:Name="GalleryList" SelectionChanged="GalleryList_SelectionChanged"
                       Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ItemContainerStyle="{StaticResource GalleryTile}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Width="176">
                      <Border Height="115" Background="{StaticResource Panel2}" CornerRadius="8" ClipToBounds="True">
                        <Image Source="{Binding Path}" Stretch="UniformToFill"/>
                      </Border>
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                 FontSize="11" Foreground="{StaticResource Muted}" Margin="5,9,4,4"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="SELECTED IMAGE" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="Preview &amp; actions" Style="{StaticResource SectionTitle}" Margin="0,10,0,14"/>
                <Border Height="280" Background="#111923" BorderBrush="{StaticResource Stroke}"
                        BorderThickness="1" CornerRadius="12" ClipToBounds="True" Margin="0,0,0,19">
                  <Grid>
                    <TextBlock Text="Select a wallpaper on the left" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                               TextAlignment="Center"/>
                    <Image x:Name="GalleryPreviewImage" Stretch="Uniform"/>
                  </Grid>
                </Border>
                <Button Content="Set as desktop wallpaper" Style="{StaticResource PrimaryButton}"
                        Click="ApplySelected_Click" Margin="0,0,0,10" HorizontalContentAlignment="Center"/>
                <Button Content="Open saved images folder" Click="OpenFolder_Click"
                        Margin="0,0,0,10" HorizontalContentAlignment="Center"/>
                <Button Content="Refresh gallery" Click="RefreshGallery_Click"
                        Margin="0,0,0,10" HorizontalContentAlignment="Center"/>
                <Button Content="Delete selected image" Click="DeleteSelected_Click"
                        Style="{StaticResource DangerButton}" Margin="0" HorizontalContentAlignment="Center"/>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="⚙   Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="MAKE IT YOURS" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Preferences." Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Control the generator, your reference photos, and when new images appear."
                       Style="{StaticResource Subtitle}" Margin="0,0,0,25"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="01  /  GENERATION" Style="{StaticResource Eyebrow}"/>
                  <TextBlock Text="Codex connection" Style="{StaticResource SectionTitle}" Margin="0,10,0,8"/>
                  <TextBlock Text="Uses a separately installed helper and your existing local Codex sign-in."
                             Style="{StaticResource Subtitle}"/>
                  <TextBlock Text="HELPER EXECUTABLE" Style="{StaticResource FieldLabel}"/>
                  <DockPanel>
                    <Button Content="Browse" Click="BrowseHelper_Click" DockPanel.Dock="Right" Margin="8,7,0,17"/>
                    <TextBox x:Name="HelperPathBox"/>
                  </DockPanel>
                  <Button Content="Check connection" Click="TestHelper_Click" HorizontalAlignment="Left" Margin="0,0,0,11"/>
                  <TextBlock x:Name="HelperStatus" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,16"/>
                  <TextBlock Text="IMAGE SIZE" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="SizePicker" Width="170" HorizontalAlignment="Left">
                    <ComboBoxItem Content="1536x1024"/><ComboBoxItem Content="1024x1024"/>
                    <ComboBoxItem Content="1024x1536"/><ComboBoxItem Content="auto"/>
                  </ComboBox>
                  <TextBlock Text="QUALITY" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="QualityPicker" Width="170" HorizontalAlignment="Left">
                    <ComboBoxItem Content="high"/><ComboBoxItem Content="medium"/>
                    <ComboBoxItem Content="low"/><ComboBoxItem Content="auto"/>
                  </ComboBox>
                  <TextBlock Text="The external helper uses undocumented endpoints; account limits apply."
                             Foreground="{StaticResource Muted}" FontSize="11"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="02  /  YOUR REFERENCES" Style="{StaticResource Eyebrow}"/>
                  <TextBlock Text="Reference photos" Style="{StaticResource SectionTitle}" Margin="0,10,0,8"/>
                  <TextBlock Text="Attach up to five local photos. You control whether they're sent for AI generation."
                             Style="{StaticResource Subtitle}"/>
                  <ListBox x:Name="PhotosList" DisplayMemberPath="Label" Height="190"
                           Background="#11171E" Margin="0,0,0,14"/>
                  <WrapPanel>
                    <Button Content="+ Add photos" Click="AddPhotos_Click"/>
                    <Button Content="Remove selected" Click="RemovePhoto_Click"/>
                  </WrapPanel>
                  <Border Background="#242E2B" BorderBrush="#3A4B3A" BorderThickness="1"
                          CornerRadius="10" Padding="12" Margin="0,17,0,0">
                    <CheckBox x:Name="ConsentCheck"
                              Content="I agree to send my selected reference photos through the unofficial Codex helper."
                              Margin="0"/>
                  </Border>
                </StackPanel>
              </Border>
            </Grid>
            <Border Style="{StaticResource Card}" Margin="0,18,0,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="03  /  AUTOMATION" Style="{StaticResource Eyebrow}"/>
                  <TextBlock Text="Your daily refresh" Style="{StaticResource SectionTitle}" Margin="0,10,0,10"/>
                  <CheckBox x:Name="ApplyCheck" Content="Automatically apply successful images to Windows desktop"/>
                  <CheckBox x:Name="ScheduleCheck" Content="Generate a new wallpaper every day"/>
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,5">
                    <TextBlock Text="Local time" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                               Margin="0,0,13,0"/>
                    <TextBox x:Name="ScheduleTimeBox" Width="78" Text="09:00" MaxLength="5" Margin="0,2,0,4"/>
                  </StackPanel>
                  <CheckBox x:Name="TrayCheck" Content="Keep running in the system tray when I close the window"/>
                  <TextBlock Text="Scheduled jobs run while you are signed in. Sleep/off PCs will not be woken."
                             Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Save preferences  →" Click="SaveSettings_Click"
                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="20,0,0,0"/>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="1" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0"
            Background="{StaticResource Side}" Padding="25,0">
      <DockPanel VerticalAlignment="Center">
        <TextBlock DockPanel.Dock="Right" Text="DAILY WALLPAPER AI   ·   WINDOWS DESKTOP"
                   Foreground="#6B7684" FontSize="10" FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
        <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,12,0"/>
        <TextBlock x:Name="StatusText" Text="Ready to create." Foreground="#B3BECA"
                   FontSize="12" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>