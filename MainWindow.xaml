<Window x:Class="DailyWallpaperAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daily Wallpaper AI" Height="780" Width="1060" MinHeight="630" MinWidth="820"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#242C3C"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="18,12"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Subtitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,2,0,12"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Daily Wallpaper AI" FontSize="28" FontWeight="Bold"/>
      <TextBlock Text="Personal wallpapers generated through your local Codex sign-in" Style="{StaticResource Subtitle}"/>
    </StackPanel>

    <TabControl Grid.Row="1" x:Name="Tabs" TabStripPlacement="Left"
                Background="{StaticResource Bg}" BorderThickness="0" SelectionChanged="Tabs_SelectionChanged">
      <TabItem Header="Home">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,0,0">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Current wallpaper" Style="{StaticResource SectionTitle}"/>
                <Border Background="{StaticResource Panel2}" CornerRadius="9" Height="280" ClipToBounds="True">
                  <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                    <TextBlock x:Name="EmptyPreview" Text="No generated wallpapers yet" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                  </Grid>
                </Border>
                <TextBlock x:Name="LastWallpaperLabel" Text="" Style="{StaticResource Subtitle}" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Create a wallpaper" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="ActiveScenarioLabel" Text="" Style="{StaticResource Subtitle}"/>
                <TextBlock Text="One-off prompt (optional — leave blank to use the active scenario)"/>
                <TextBox x:Name="OneOffPromptBox" AcceptsReturn="True" TextWrapping="Wrap" Height="68" VerticalScrollBarVisibility="Auto"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="GenerateButton" Background="{StaticResource Accent}" FontWeight="Bold" Content="✦  Generate now" Click="Generate_Click"/>
                  <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False"/>
                  <Button Content="Open wallpaper folder" Click="OpenFolder_Click"/>
                </StackPanel>
                <TextBlock Text="Each successful render is saved locally. Applying it to Windows is optional." Style="{StaticResource Subtitle}" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Scenarios">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,0,0">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Wallpaper scenarios" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Use {{place}} and {{mood}} in the prompt to rotate locations and lighting without repeats until all combinations are used." Style="{StaticResource Subtitle}"/>
                <DockPanel>
                  <ComboBox x:Name="ScenarioPicker" Width="295" DisplayMemberPath="Name" SelectionChanged="ScenarioPicker_SelectionChanged" DockPanel.Dock="Left"/>
                  <Button Content="+ New" Click="AddScenario_Click" Margin="8,2,0,10"/>
                  <Button Content="Delete" Click="DeleteScenario_Click" Margin="0,2,0,10"/>
                </DockPanel>
                <TextBlock Text="Scenario name"/>
                <TextBox x:Name="ScenarioName"/>
                <TextBlock Text="Prompt template"/>
                <TextBox x:Name="ScenarioPrompt" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Places (one per line)"/>
                    <TextBox x:Name="PlacesBox" AcceptsReturn="True" Height="95" VerticalScrollBarVisibility="Auto"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Moods (one per line)"/>
                    <TextBox x:Name="MoodsBox" AcceptsReturn="True" Height="95" VerticalScrollBarVisibility="Auto"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="Style"/>
                <TextBox x:Name="ScenarioStyle"/>
                <TextBlock Text="Avoid"/>
                <TextBox x:Name="ScenarioAvoid"/>
                <Button Content="Save scenario" HorizontalAlignment="Left" Background="{StaticResource Accent}" Click="SaveScenario_Click"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Gallery">
        <Grid Margin="16,0,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Saved wallpapers" Style="{StaticResource SectionTitle}"/>
          <ListBox Grid.Row="1" x:Name="GalleryList" Background="{StaticResource Panel}" Foreground="{StaticResource Fg}"
                   DisplayMemberPath="Name" SelectionChanged="GalleryList_SelectionChanged"/>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Set selected as wallpaper" Click="ApplySelected_Click"/>
            <Button Content="Open folder" Click="OpenFolder_Click"/>
            <Button Content="Refresh" Click="RefreshGallery_Click"/>
            <Button Content="Delete selected" Click="DeleteSelected_Click"/>
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,0,0">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Codex image backend" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Uses the separately installed codex-imagegen helper and the signed-in Windows user's Codex account. The helper reads local Codex credentials and calls undocumented ChatGPT endpoints; account usage limits apply." Style="{StaticResource Subtitle}"/>
                <TextBlock Text="Helper executable path (leave blank for automatic discovery)"/>
                <DockPanel>
                  <Button Content="Browse" Click="BrowseHelper_Click" DockPanel.Dock="Right" Margin="8,4,0,12"/>
                  <TextBox x:Name="HelperPathBox"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Check installed helper" Click="TestHelper_Click"/>
                  <TextBlock x:Name="HelperStatus" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                </StackPanel>
                <TextBlock Text="Image size"/>
                <ComboBox x:Name="SizePicker" Width="170" HorizontalAlignment="Left">
                  <ComboBoxItem Content="1536x1024"/><ComboBoxItem Content="1024x1024"/>
                  <ComboBoxItem Content="1024x1536"/><ComboBoxItem Content="auto"/>
                </ComboBox>
                <TextBlock Text="Quality"/>
                <ComboBox x:Name="QualityPicker" Width="170" HorizontalAlignment="Left">
                  <ComboBoxItem Content="high"/><ComboBoxItem Content="medium"/>
                  <ComboBoxItem Content="low"/><ComboBoxItem Content="auto"/>
                </ComboBox>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Photo references" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Optional: attach 1–5 photographs of the same person. They are copied into your local profile and passed to the Codex image-edit helper when generating." Style="{StaticResource Subtitle}"/>
                <ListBox x:Name="PhotosList" Background="{StaticResource Panel2}" Foreground="{StaticResource Fg}" Height="112" DisplayMemberPath="Label"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="+ Add photos" Click="AddPhotos_Click"/>
                  <Button Content="Remove selected" Click="RemovePhoto_Click"/>
                </StackPanel>
                <CheckBox x:Name="ConsentCheck" Content="I agree to send these selected photos to ChatGPT through the unofficial Codex helper."/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Automation" Style="{StaticResource SectionTitle}"/>
                <CheckBox x:Name="ApplyCheck" Content="Automatically set successfully generated images as Windows wallpaper"/>
                <CheckBox x:Name="ScheduleCheck" Content="Generate one new wallpaper every day"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                  <TextBlock Text="Local time:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <TextBox x:Name="ScheduleTimeBox" Width="75" Text="09:00" MaxLength="5"/>
                </StackPanel>
                <CheckBox x:Name="TrayCheck" Content="When closing the window, keep it running in the system tray"/>
                <TextBlock Text="Automatic runs use Windows Task Scheduler while you're signed in. Sleeping or powered-off PCs are not woken. Re-enable the schedule if you move the program folder." Style="{StaticResource Subtitle}"/>
                <Button Content="Save settings and schedule" HorizontalAlignment="Left" Background="{StaticResource Accent}" Click="SaveSettings_Click"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="12" Margin="0,14,0,0">
      <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Text="Ready"/>
    </Border>
  </Grid>
</Window>
